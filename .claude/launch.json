{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zeila-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "zeila-built",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "zeila-api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "localhost:8090",
        "-t",
        "public"
      ],
      "port": 8090
    }
  ]
}